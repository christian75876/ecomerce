{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "merku",
  "main": "worker/index.js",
  "compatibility_date": "2026-08-17",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // El Worker corre primero en todas las rutas ("/*"): con una lista de rutas
    // puntuales, cualquier ruta no listada se servía directo desde el fallback
    // SPA de Cloudflare sin pasar por worker/index.js (bots, OG y 404 reales
    // quedaban sin efecto — verificado con curl).
    //
    // Excepto los archivos estáticos del build ("!..."; los negativos tienen
    // prioridad): servidos sin el Worker son gratis e ilimitados, mientras que
    // con run_worker_first: true cada JS/CSS/ícono contaba como una invocación
    // (20-40 por visita) contra el límite diario del plan gratuito. Además,
    // public/_headers solo se aplica a lo que NO pasa por el Worker.
    // /index.html sigue pasando por el Worker a propósito (responde 404 en vez
    // de quedar como URL duplicada).
    "run_worker_first": [
      "/*",
      "!/assets/*",
      "!/icons/*",
      "!/draco/*",
      "!/favicon.ico",
      "!/favicon.svg",
      "!/apple-touch-icon.png",
      "!/og-image.png",
      "!/vite.svg",
      "!/manifest.webmanifest",
      "!/sw.js",
      "!/robots.txt",
      "!/llms.txt"
    ],
    "html_handling": "none"
  }
}
