# API del backend
# Usa VITE_API_URL en local y VITE_API_BASE_URL en plataformas como Vercel/Netlify
VITE_API_URL=http://localhost:3000/api
VITE_API_BASE_URL=http://localhost:3000/api

# URL pública del frontend (usada en OG meta tags)
# Producción: https://merku.co
VITE_APP_URL=http://localhost:5173

# Contacto administrador (aparece en formularios de registro y soporte)
VITE_ADMIN_WHATSAPP=573000000000
VITE_ADMIN_EMAIL=admin@merku.co

# WhatsApp de soporte general (fallback si la tienda no tiene número propio)
VITE_WHATSAPP_SUPPORT=573000000000

# Web Push — clave pública VAPID (genera con: npx web-push generate-vapid-keys)
VITE_VAPID_PUBLIC_KEY=your-vapid-public-key

# Cloudflare Turnstile — CAPTCHA en login/registro (https://dash.cloudflare.com → Turnstile)
# En dev puedes dejar vacío; se usará la test key que siempre pasa
# En producción: crea un widget en Cloudflare y pega el Site Key aquí
VITE_TURNSTILE_SITE_KEY=

# Sentry — monitoreo de errores en producción (https://sentry.io)
# Dejar vacío para desactivar en desarrollo
VITE_SENTRY_DSN=
