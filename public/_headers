# Cabeceras para los archivos estáticos que Cloudflare sirve sin pasar por el
# Worker (ver los "!..." de run_worker_first en wrangler.jsonc). No se aplican
# a respuestas generadas por worker/index.js.

# Nombres con hash del contenido (Vite): cambian en cada build, así que se
# pueden cachear para siempre sin riesgo de servir una versión vieja.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

/draco/*
  Cache-Control: public, max-age=31536000, immutable

# Íconos e imagen OG: nombre fijo, caché de un día.
/icons/*
  Cache-Control: public, max-age=86400

/og-image.png
  Cache-Control: public, max-age=86400

# sw.js: sin caché, o los usuarios tardarían en recibir actualizaciones de la app.
/sw.js
  Cache-Control: no-cache
