{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "merku",
  "main": "worker/index.js",
  "compatibility_date": "2026-08-17",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "html_handling": "none"
  }
}
