{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "merku",
  "main": "worker/index.js",
  "compatibility_date": "2026-08-17",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // Las navegaciones de navegador (Sec-Fetch-Mode: navigate) a rutas que no
    // son archivos reciben el index.html de la SPA sin pasar por el Worker;
    // /sitemap.xml lo genera el Worker, así que debe correr primero.
    "run_worker_first": ["/sitemap.xml", "/merchant-feed.xml"],
    "html_handling": "none"
  }
}
